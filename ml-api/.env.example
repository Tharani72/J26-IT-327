# Configure local credentials outside source control. Never use a Supabase service-role key here.
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
SUPABASE_ANON_KEY=SET_OUT_OF_BAND_PUBLIC_ANON_KEY
ML_DATABASE_URL=postgresql://omnisign_ml_reader:SET_OUT_OF_BAND@YOUR_SUPABASE_DB_HOST:5432/postgres
SEED_DATABASE_URL=postgresql://omnisign_ml_seed:SET_OUT_OF_BAND@YOUR_SUPABASE_DB_HOST:5432/postgres
DEMO_STUDENT_PASSWORD=
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
